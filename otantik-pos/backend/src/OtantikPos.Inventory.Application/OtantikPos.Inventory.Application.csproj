<Project Sdk="Microsoft.NET.Sdk">

  <!-- References Ordering's contracts (its events), never its domain or application: Inventory
       learns of a sale only as catalog ids and a quantity. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OtantikPos.Inventory.Domain\OtantikPos.Inventory.Domain.csproj" />
    <ProjectReference Include="..\OtantikPos.Ordering.Contracts\OtantikPos.Ordering.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="[12.5.0]" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

</Project>
