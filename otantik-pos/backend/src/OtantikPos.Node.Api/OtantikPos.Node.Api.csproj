<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The restaurant machine's API: the tills' REST endpoints and SignalR hub, and the Angular
       app's files. Runs on the one machine in the restaurant, beside its PostgreSQL, and keeps
       working when the internet does not. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OtantikPos.Node.Infrastructure\OtantikPos.Node.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same packages, on the same 10.0 line, as the delivery system's API. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

</Project>
