<Project Sdk="Microsoft.NET.Sdk">

  <!-- The events the Ordering module publishes, and the only Ordering types another module may
       reference. Deliberately no reference to the shared order model: Inventory consumes these
       events and must not be able to reach Order. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- INotification only. Apache-2.0, the version MediatR 12.5.0 itself depends on. -->
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
  </ItemGroup>

</Project>
