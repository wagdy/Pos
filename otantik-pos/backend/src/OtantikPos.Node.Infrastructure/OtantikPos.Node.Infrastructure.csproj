<Project Sdk="Microsoft.NET.Sdk">

  <!-- The restaurant machine's infrastructure: its PostgreSQL database, the outbox, the thermal
       printers, and the link to the delivery system in the cloud. Implements the ports of
       both POS modules (Ordering and Inventory). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OtantikPos.Ordering.Application\OtantikPos.Ordering.Application.csproj" />
    <ProjectReference Include="..\OtantikPos.Inventory.Application\OtantikPos.Inventory.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- Pins EF Core for every project that uses this one. The Design package below is private
         to this project but lifts EF Core to its own patch here, while a consumer such as the
         API would otherwise resolve Npgsql's older minimum, and then load an older EF Core
         than this assembly was built against. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <!-- The same resilience package the delivery system's API uses. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

</Project>
