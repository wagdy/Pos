# The till's settings. Copy this file to .env (in this same folder) and fill it in.
# .env holds secrets: never commit it or send it around.
#
# To make a long random secret, run this on the till machine (any OS, once Docker is installed):
#   docker run --rm alpine sh -c "head -c 48 /dev/urandom | base64"

# ---- Secrets: one random value each ----
# The till's database password. Set once, before the first start; changing it later needs the
# database changed too.
DB_PASSWORD=
# Signs the staff's sign-ins on the tills. Changing it signs everyone out, nothing else.
TILL_SIGNING_KEY=

# ---- The first manager ----
# Only for the very first start, so somebody can sign in and give the staff their PINs.
# Remove the PIN (leave it empty) once you have, and run `docker compose up -d` again.
BOOTSTRAP_MANAGER_NAME=Manager
BOOTSTRAP_MANAGER_PIN=

# ---- The delivery system ----
# Leave empty to run the till on its own: no menu sync, no customers or points, no captains'
# orders. The key must be the same as the delivery system's PosSync__NodeKey on Railway.
DELIVERY_SYSTEM_URL=https://api-production-0b83e.up.railway.app
DELIVERY_SYSTEM_NODE_KEY=

# Only if the till must sell before it has ever reached the delivery system (it refuses to
# price an order until then). The delivery system's own rate replaces it at the first sync.
TAX_PERCENTAGE_UNTIL_SYNCED=

# ---- Printers: network (ESC/POS) printers, usually port 9100 ----
# Give each printer a fixed IP address in the router. Empty: jobs wait until one is set.
KITCHEN_PRINTER_HOST=
KITCHEN_PRINTER_PORT=9100
RECEIPT_PRINTER_HOST=
RECEIPT_PRINTER_PORT=9100
# The first line printed on every receipt.
RECEIPT_HEADER=Otantik

# ---- This machine ----
# The port the tills open: http://<this machine's IP>:5080
TILL_PORT=5080
# The restaurant's time zone: the business day (and its 4 AM cut-off) is counted in it.
RESTAURANT_TIME_ZONE=Africa/Cairo
